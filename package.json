{
  "name": "goblin",
  "scripts": {
    "check": "bun run check:format && bun run check:types",
    "check:format": "biome check --use-editorconfig true",
    "check:types": "tsc -p . --noEmit",
    "format": "biome format --write --use-editorconfig true",
    "dev": "bun src/cli.ts",
    "ui": "PORT=1337 bun ui/server.ts",
    "test": "vitest run",
    "build": "bun build --compile src/cli.ts --outfile build/goblin && rm -f .*.bun-build"
  },
  "bin": {
    "goblin": "build/goblin"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.5",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "indent-string": "5.0.0",
    "micro-memoize": "5.1.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "radashi": "12.7.1",
    "ts-pattern": "5.9.0",
    "yaml": "2.9.1"
  }
}
