{
  "name": "goblin",
  "exports": {
    ".": "./src/main.ts",
    "./client": "./src/client/main.ts"
  },
  "scripts": {
    "check": "bun run check:format && bun run check:types && bun run check:unused",
    "check:format": "biome check --use-editorconfig true",
    "check:types": "tsc -p . --noEmit",
    "check:unused": "knip",
    "format": "biome check --write --use-editorconfig true",
    "dev": "bun src/cli/cli.ts",
    "ui": "PORT=1337 bun ui/server.ts",
    "test": "vitest run",
    "build": "bun build --compile src/cli/cli.ts --outfile build/goblin && rm -f .*.bun-build"
  },
  "bin": {
    "goblin": "build/goblin"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.5",
    "knip": "6.41.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "cbor-x": "1.6.6",
    "ts-pattern": "5.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
