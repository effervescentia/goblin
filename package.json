{
  "name": "goblin",
  "scripts": {
    "check": "bun run check:format && bun run check:types",
    "check:format": "biome check --use-editorconfig true",
    "check:types": "tsc -p . --noEmit",
    "format": "biome format --write --use-editorconfig true",
    "dev": "bun src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "indent-string": "5.0.0",
    "micro-memoize": "5.1.1",
    "radashi": "12.7.1",
    "ts-pattern": "5.9.0"
  }
}
